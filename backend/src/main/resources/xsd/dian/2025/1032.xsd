					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="dpto" use="required">
				<xs:annotation>
					<xs:documentation>Código Dpto Notaria</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:int">
						<xs:minInclusive value="0"/>
