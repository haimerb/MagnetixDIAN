# Plantilla de credenciales por proveedor (valores vacíos; NO se leen de .env).
# Se guardan cifradas por empresa en integracion_config desde la UI /api/empresas/{id}/integraciones.
# SIIGO: username= accessKey= url=
# ALEGRA: email= apiToken=
# ODOO: url= db= username= password= webhookSecret=
# WORLD_OFFICE: apiToken= username= password= webhookSecret=
# HELISA: usuario= clave= url= sign= empresa= webhookSecret=
# SHOPIFY: shop= accessToken= webhookSecret=
# WOOCOMMERCE: url= consumerKey= consumerSecret= webhookSecret=
# SAP_BUSINESS_ONE: url= companyDB= username= password=
# DYNAMICS_365: url= tenantId= clientId= clientSecret=
# NETSUITE: accountId= consumerKey= consumerSecret= tokenId= tokenSecret=

