# Desarrollo local: valores de ejemplo permitidos solo con SEGURIDAD_FAIL_FAST=false.
# Producción (Render): SEGURIDAD_FAIL_FAST=true y secretos reales obligatorios
# (JWT_SECRET, CRYPTO_KEY, CRYPTO_KEY_ID, FRONTEND_URL, WOMPI_EVENTS_SECRET,
# MERCADOPAGO_WEBHOOK_SECRET, PAGOS_EXIGIR_FIRMA_WEBHOOK=true,
# INTEGRACIONES_EXIGIR_FIRMA_WEBHOOK=true, TENANT_FILTER_ENABLED=true,
# AUTH_EXPOSE_TOKEN=false). Nunca caer a SIMULADO ni a secretos de ejemplo.
DB_URL=jdbc:postgresql://localhost:5432/magnetixdian?characterEncoding=UTF-8
DB_USER=magnetixdian
DB_PASSWORD=cambiar
JWT_SECRET=base64-de-64-bytes
CRYPTO_KEY=base64-de-32-bytes
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
FRONTEND_URL=http://localhost:5173
AUTH_EXPOSE_TOKEN=true
UPLOAD_DIR=./uploads
NOTIFICATIONS_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
VITE_API_BASE_URL=/api
VITE_SENTRY_DSN=
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_BACK_URL=
MERCADOPAGO_WEBHOOK_SECRET=
PAGOS_WEBHOOK_TOLERANCE_SECONDS=300
# En Render: true (fail-closed sin secreto de firma).
PAGOS_EXIGIR_FIRMA_WEBHOOK=false
WOMPI_API_TOKEN=
WOMPI_API_URL=https://api.wompi.co
WOMPI_QR_POLL_ATTEMPTS=10
WOMPI_QR_POLL_INTERVAL_MS=500
WOMPI_BREB_QR_SANDBOX_STATUS=APPROVED

# Integraciones — platform-wide; en Render ambas firmas deben quedar en true.
INTEGRACIONES_EXIGIR_FIRMA_WEBHOOK=false
INTEGRACIONES_CONNECT_TIMEOUT_MS=5000
INTEGRACIONES_READ_TIMEOUT_MS=15000
INTEGRACIONES_REINTENTOS_MS=60000

# Plantilla de credenciales por proveedor (valores vacíos; NO se leen de .env).
# Se guardan cifradas por empresa en integracion_config desde la UI /api/empresas/{id}/integraciones.
# SIIGO: username= accessKey= url=
# ALEGRA: email= apiToken=
# ODOO: url= db= username= password= webhookSecret=
# WORLD_OFFICE: apiToken= username= password= webhookSecret=
# HELISA: usuario= clave= url= sign= empresa= webhookSecret=
# SHOPIFY: shop= accessToken= webhookSecret=
# WOOCOMMERCE: url= consumerKey= consumerSecret= webhookSecret=
# SAP_BUSINESS_ONE: url= companyDB= username= password=
# DYNAMICS_365: url= tenantId= clientId= clientSecret=
# NETSUITE: accountId= consumerKey= consumerSecret= tokenId= tokenSecret=

PAC_CONNECT_TIMEOUT_MS=5000
PAC_READ_TIMEOUT_MS=30000
DIAN_URL_HABILITACION=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc
DIAN_URL_PRODUCCION=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc
DIAN_CONNECT_TIMEOUT_MS=30000
DIAN_REQUEST_TIMEOUT_MS=60000

# Traer documentos de la DIAN (el token de usuario NO va aquí; se guarda cifrado por empresa)
DIAN_CATALOGO_BASE_URL=https://catalogo-vpfe.dian.gov.co
DIAN_CATALOGO_TOKEN_URL=
DIAN_CATALOGO_LISTADO_URL=
DIAN_CATALOGO_HOSTS_PERMITIDOS=catalogo-vpfe.dian.gov.co,vpfe.dian.gov.co,vpfe-hab.dian.gov.co
DIAN_CATALOGO_CONNECT_TIMEOUT_MS=5000
DIAN_CATALOGO_READ_TIMEOUT_MS=60000
DIAN_CATALOGO_MAX_BYTES=52428800

# Seguridad / cifrado v2 (CRYPTO_KEY nunca se regenera en producción)
CRYPTO_KEY_ID=primary
CRYPTO_EXTRA_KEYS=
SEGURIDAD_FAIL_FAST=false
TENANT_FILTER_ENABLED=false

# WhatsApp Click-to-Chat y branding por empresa
WHATSAPP_BASE_URL=https://wa.me
WHATSAPP_DEFAULT_TEMPLATE=Hola, le compartimos su factura {numero} por un total de {total}. ¡Gracias!
BRANDING_PRIMARY_COLOR="#0E5C55"
BRANDING_ACCENT_COLOR="#D98A2B"
BRANDING_FONT_FAMILY=Roboto
BRANDING_PWA_BACKGROUND_COLOR="#FFFFFF"
